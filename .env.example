PORT=5000
# JWT Secret Key (Must be a cryptographically secure key of at least 32 characters / 256 bits)
# You can generate a secure secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_password

# Razorpay Credentials (Never expose these in frontend)
